# Copy to .env.local and fill in. If SMTP_HOST is empty the site uses a
# throwaway Ethereal test inbox: nothing is delivered, but the booking
# confirmation screen shows links to preview both emails (handy for demos).

# SMTP server (e.g. Gmail: smtp.gmail.com / 465 / true + an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender shown on the emails
MAIL_FROM="Aberash Lodge <reservations@aberashlodge.com>"

# Where booking requests and enquiries are delivered
RECEPTION_EMAIL=reception@aberashlodge.com

# Public URL of the site (used for social share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

