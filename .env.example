# Copy to .env.local and fill in. If SMTP_HOST is empty the site uses a
# throwaway Ethereal test inbox: nothing is delivered, but the booking
# confirmation screen shows links to preview both emails (handy for demos).

# SMTP server (e.g. Gmail: smtp.gmail.com / 465 / true + an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender shown on the emails
MAIL_FROM="Green Mark Lodge <reservations@greenmarklodge.com>"

# Where booking requests and enquiries are delivered
RECEPTION_EMAIL=reception@greenmarklodge.com

# Public URL of the site (used for social share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API Keys). Without these the
# site runs on the built-in content in src/content/fallback.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Only for `npm run migrate` (scripts), not needed on Vercel.
SUPABASE_DB_PASSWORD=
# Optional: session pooler host from Dashboard → Connect (default aws-0-eu-west-1).
# SUPABASE_DB_HOST=

# Protects /api/keepalive; Vercel sends it automatically to cron jobs.
CRON_SECRET=

